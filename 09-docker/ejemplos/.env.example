# .env.example REAL de la Actividad 4 (con explicaciones agregadas)
#
# Copiar a .env y ajustar:
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# Compose lee .env automaticamente. El .env real NO se sube al repo.
#
# Cómo se usa: en docker-compose.yml aparece ${POSTGRES_PASSWORD:-clave_de_ejemplo}.
# Compose busca POSTGRES_PASSWORD aquí; si no la encuentra, usa el valor después de :-
# Para ver el compose con las variables ya reemplazadas:  docker compose config

POSTGRES_DB=predicciones
POSTGRES_USER=mlops
POSTGRES_PASSWORD=cambia_esta_clave

# Puerto de TU compu donde queda la API (lado izquierdo de "8000:8000").
# Si el 8000 está ocupado por otra cosa, pon 9000 y abre http://localhost:9000/docs
PUERTO_API=8000

# Combinaciones que prueba la busqueda de hiperparametros (mas = mas lento)
N_ITER=60

# Poner en 1 para reentrenar aunque ya exista un modelo en el volumen
FORZAR_REENTRENO=0
